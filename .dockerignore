# Build context for deploy/sandbox/Dockerfile is the repo root. Trim it to keep
# the context small and to keep secrets/large restorable artifacts out of the image.
# node_modules is rebuilt inside the image via `bun install --frozen-lockfile`.
.git
node_modules
**/node_modules
**/node_modules/**
.frontend-dist

# Secrets / local config — must never be baked into an image.
mcp-config.json
mcp-config.json.bak
*.env
*.env.*
!*.env.example
!*.env.*.example
.envrc
.envrc.*
*.key
*.pem
*.p12
*.pfx
*.pkcs12
*.ppk
*.cer
*.crt
*.csr
*.der
*.jks
*.keystore
AGENTS.local.md
CLAUDE.local.md

# Caches / logs / session-generated scratch
.users_cache.json
.channels_cache.json
.channels_cache_v2.json
*.log
.artifacts
.capture
.captures
.hero-check
.opensession-review
.review-fix
.session-preview
.shots
.shots-tmp
.tmp*
.worktrees
output/*
!output/os1-icons/
!output/os1-icons/**
